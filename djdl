# ---- terminal output ------------------------------------------------------ #
def use_color():
    return sys.stdout.isatty() and os.environ.get("TERM", "") != "dumb"


def paint(text, code):
    return f"\033[{code}m{text}\033[0m" if use_color() else text


def heading(text):
    print("\n" + paint(text, "1;36"))


MARKS = {
    "ok": ("✓", "32"),
    "warn": ("!", "33"),
    "bad": ("✗", "31"),
    "info": ("·", "90"),
}


def report(state, label, detail=""):
    mark, color = MARKS[state]
    line = f"  {paint(mark, color)} {label}"
    if detail:
        line += paint(f" — {detail}", "90")
    print(line)


def note(text):
    for line in text.strip("\n").split("\n"):
        print(paint(f"    {line}", "90"))


def interactive():
    return sys.stdin.isatty()


def ask_yes(prompt, default=True):
    """Ask a yes/no question. Non-interactive runs never assume a fix is wanted."""
    if not interactive():
        return False
    suffix = "[Y/n]" if default else "[y/N]"
    while True:
        try:
            answer = input(f"    {paint('?', '35')} {prompt} {suffix} ").strip().lower()
        except EOFError:
            print()
            return default
        if not answer:
            return default
        if answer in ("y", "yes"):
            return True
        if answer in ("n", "no"):
            return False


def ask_text(prompt, default=""):
    if not interactive():
        return default
    shown = f" [{default}]" if default else ""
    try:
        answer = input(f"    {paint('?', '35')} {prompt}{shown}: ").strip()
    except EOFError:
        print()
        return default
    return answer or default


def ask_choice(prompt, choices, default):
    if not interactive():
        return default
    while True:
        answer = ask_text(f"{prompt} ({'/'.join(choices)})", default).lower()
        if answer in choices:
            return answer
        print(paint(f"      pick one of: {', '.join(choices)}", "31"))


# ---- shelling out --------------------------------------------------------- #
def run_visible(cmd):
    print(paint(f"    $ {' '.join(cmd)}", "90"))
    try:
        return subprocess.run(cmd).returncode
    except (FileNotFoundError, KeyboardInterrupt):
        return 1


def run_quiet(cmd, timeout=None):
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except FileNotFoundError:
        return 127, ""
    except subprocess.TimeoutExpired:
        return 124, ""
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def find_brew():
    brew = shutil.which("brew")
    if brew:
        return brew
    for candidate in ("/opt/homebrew/bin/brew", "/usr/local/bin/brew"):
        if os.path.exists(candidate):
            return candidate
    return None


def install_with_brew(package):
    brew = find_brew()
    if not brew:
        report("bad", "Homebrew is not installed", "it's the easiest way to get the rest")
        note('Install it with:\n'
             '  /bin/bash -c "$(curl -fsSL '
             'https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"\n'
             "Then run the two `eval` lines it prints, and re-run `djdl setup`.")
        return False
    return run_visible([brew, "install", package]) == 0


def install_with_pip(package):
    """Install into the same interpreter running djdl, so imports actually resolve."""
    rc = run_visible([sys.executable, "-m", "pip", "install", "--user", package])
    if rc == 0:
        return True
    # Homebrew/system pythons refuse --user installs (PEP 668) unless told twice.
    if ask_yes(f"pip refused. Retry with --break-system-packages for {package}?", default=True):
        rc = run_visible([sys.executable, "-m", "pip", "install", "--user",
                          "--break-system-packages", package])
    return rc == 0


# ---- checks --------------------------------------------------------------- #
def have_dependency(dep):
    if dep["kind"] == "module":
        import importlib.util
        return importlib.util.find_spec(dep["name"]) is not None
    return find_exe(dep["name"]) is not None


def dependency_location(dep):
    if dep["kind"] == "module":
        return "importable"
    path = find_exe(dep["name"])
    if path and not shutil.which(dep["name"]):
        return f"{path} (not on PATH — yt-dlp may not see it)"
    return path or ""


def ytdlp_age_days():
    """Days since the installed yt-dlp was released (its version is a date)."""
    exe = find_exe("yt-dlp")
    if not exe:
        return None, None
    rc, out = run_quiet([exe, "--version"], timeout=30)
    version = out.strip().splitlines()[-1].strip() if out.strip() else ""
    m = re.match(r"(\d{4})\.(\d{2})\.(\d{2})", version)
    if rc != 0 or not m:
        return version or None, None
    import datetime
    released = datetime.date(*(int(g) for g in m.groups()))
    return version, (datetime.date.today() - released).days


def python_for_script(path):
    """The interpreter a pip console script runs under, from its shebang."""
    try:
        with open(path) as f:
            first = f.readline().strip()
    except OSError:
        return None
    if first.startswith("#!") and "python" in first:
        return first[2:].strip().split()[0]
    return None


def upgrade_ytdlp():
    exe = find_exe("yt-dlp")
    if not exe:
        return False
    if "/Cellar/" in os.path.realpath(exe) or exe.startswith(("/opt/homebrew", "/usr/local")):
        brew = find_brew()
        if brew:
            return run_visible([brew, "upgrade", "yt-dlp"]) == 0
    # pip installs refuse `yt-dlp --update`, so go through the pip that owns it.
    python = python_for_script(exe) or sys.executable
    return run_visible([python, "-m", "pip", "install", "--user", "--upgrade",
                        "yt-dlp", "yt-dlp-ejs"]) == 0


def step_ytdlp_freshness(fix):
    version, age = ytdlp_age_days()
    if version is None:
        return []
    if age is None:
        report("info", f"yt-dlp {version}", "couldn't read its release date")
        return []
    if age <= YTDLP_STALE_DAYS:
        report("ok", f"yt-dlp {version}", f"{age} days old")
        return []
    report("warn", f"yt-dlp {version} is {age} days old",
           "stale yt-dlp is the usual cause of sudden failures")
    if fix and ask_yes("Upgrade yt-dlp now?", default=True):
        if upgrade_ytdlp():
            new_version, _ = ytdlp_age_days()
            report("ok", f"yt-dlp now {new_version}")
        else:
            report("bad", "the upgrade failed", "try it by hand")
    return []


def step_dependencies(fix):
    heading("1. Tools djdl needs")
    blockers = []
    for dep in DEPENDENCIES:
        if have_dependency(dep):
            report("ok", dep["name"], dependency_location(dep))
            continue

        state = "bad" if dep["required"] else "warn"
        report(state, f"{dep['name']} missing", dep["why"])
        installed = False
        if fix and ask_yes(f"Install {dep['name']} now?", default=dep["required"]):
            if dep.get("brew") and (find_brew() or not dep.get("pip")):
                installed = install_with_brew(dep["brew"])
            elif dep.get("pip"):
                installed = install_with_pip(dep["pip"])
            if installed:
                # Re-resolve: a fresh install won't be in shutil.which's cache-free
                # lookup unless PATH already covers it.
                installed = have_dependency(dep)
            report("ok" if installed else "bad",
                   f"{dep['name']} installed" if installed else f"{dep['name']} still missing")
        if not installed and dep["required"]:
            blockers.append(f"{dep['name']} is required — install it and re-run `djdl setup`")
    blockers += step_ytdlp_freshness(fix)
    return blockers


def shell_rc_path():
    shell = os.environ.get("SHELL", "")
    if shell.endswith("zsh"):
        return Path.home() / ".zshrc"
    if shell.endswith("bash"):
        return Path.home() / ".bash_profile"
    return None


def step_command(fix):
    heading("2. The `djdl` command itself")
    blockers = []
    self_path = Path(__file__).resolve()
    on_path = shutil.which("djdl")
    installed_path = LOCAL_BIN / "djdl"

    if on_path and Path(on_path).resolve() == self_path:
        report("ok", "`djdl` runs from this script", on_path)
    elif on_path:
        report("warn", "`djdl` on PATH is a different copy", on_path)
        note(f"You are running: {self_path}")
        if fix and ask_yes("Update the copy on PATH from this script?", default=True):
            try:
                shutil.copyfile(str(self_path), on_path)
                os.chmod(on_path, 0o755)
                report("ok", "copy on PATH updated", on_path)
            except OSError as e:
                report("bad", "could not update it", str(e))
    else:
        report("warn", "`djdl` is not on your PATH",
               "you'd have to type its full path every time")
        if fix and ask_yes(f"Install it to {installed_path}?", default=True):
            try:
                LOCAL_BIN.mkdir(parents=True, exist_ok=True)
                shutil.copyfile(str(self_path), str(installed_path))
                os.chmod(str(installed_path), 0o755)
                report("ok", "installed", str(installed_path))
            except OSError as e:
                report("bad", "install failed", str(e))
                blockers.append(f"could not install djdl to {installed_path}: {e}")

    # Whether or not we just copied it, ~/.local/bin has to be on PATH.
    path_entries = os.environ.get("PATH", "").split(os.pathsep)
    if str(LOCAL_BIN) in path_entries:
        report("ok", f"{LOCAL_BIN} is on your PATH")
    else:
        report("warn", f"{LOCAL_BIN} is not on your PATH")
        rc_file = shell_rc_path()
        export_line = 'export PATH="$HOME/.local/bin:$PATH"'
        if fix and rc_file and ask_yes(f"Add it to {rc_file}?", default=True):
            try:
                existing = rc_file.read_text() if rc_file.exists() else ""
                if export_line in existing:
                    report("ok", f"already in {rc_file.name}", "open a new terminal to pick it up")
                else:
                    with open(rc_file, "a") as f:
                        f.write(f"\n# added by djdl setup\n{export_line}\n")
                    report("ok", f"added to {rc_file.name}",
                           "run `exec $SHELL` or open a new terminal")
            except OSError as e:
                report("bad", f"could not write {rc_file}", str(e))
        elif not rc_file:
            note(f"Add this to your shell's startup file:\n  {export_line}")
    return blockers


def step_config(fix):
    heading("3. Where your music lives")
    cfg = load_config()
    first_time = cfg is None
    if first_time:
        cfg = default_config()
        report("info", "no config yet", str(CONFIG_PATH))
    else:
        report("ok", "config found", str(CONFIG_PATH))

    if fix and (first_time or ask_yes(f"Music folder is {cfg['music_dir']}. Change it?",
                                      default=False)):
        answer = ask_text("Folder for downloaded tracks", cfg["music_dir"])
        music_dir = Path(answer).expanduser()
        cfg["music_dir"] = str(music_dir)
        cfg["xml_path"] = str(music_dir / "rekordbox.xml")

    music_dir = Path(cfg["music_dir"])
    if music_dir.parts[:2] == ("/", "Volumes") and not music_dir.exists():
        report("warn", "that folder is on a volume that isn't mounted", str(music_dir))

    if music_dir.exists():
        report("ok", "music folder", str(music_dir))
    elif not fix:
        # doctor changes nothing — just say what setup would do.
        report("warn", "music folder doesn't exist yet", str(music_dir))
        return cfg, ["music folder doesn't exist yet — run `djdl setup`"]
    else:
        try:
            music_dir.mkdir(parents=True, exist_ok=True)
            report("ok", "music folder created", str(music_dir))
        except OSError as e:
            report("bad", "cannot create the music folder", str(e))
            return cfg, [f"music folder {music_dir} is not usable: {e}"]

    if not os.access(str(music_dir), os.W_OK):
        report("bad", "music folder is not writable", str(music_dir))
        return cfg, [f"music folder {music_dir} is not writable"]

    if fix:
        save_config(cfg)
    report("ok", f"format: {cfg['format']}", "change with `djdl config format m4a|mp3-320`")
    report("ok", f"playlist name: {cfg.get('playlist_name', DEFAULT_PLAYLIST_NAME)}")
    return cfg, []


def terminal_app_name():
    term = os.environ.get("TERM_PROGRAM", "")
    return TERM_APP_NAMES.get(term, term or "your terminal app")


def safari_cookie_access():
    """('ok'|'denied'|'missing', path) — 'denied' means Full Disk Access is off."""
    for path in SAFARI_COOKIE_PATHS:
        try:
            with open(path, "rb") as f:
                f.read(4)
            return "ok", path
        except PermissionError:
            return "denied", path
        except FileNotFoundError:
            continue
        except OSError:
            return "denied", path
    return "missing", None


def open_full_disk_access_pane():
    subprocess.run([
        "open",
        "x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles",
    ])


def step_cookies(cfg, fix):
    heading("4. Download quality (YouTube Premium cookies)")
    browser = cfg.get("cookies_browser", "")

    if not browser and fix:
        note("Without a login YouTube serves ~128 kbps. With a YouTube Premium\n"
             "login it serves ~256 kbps AAC — the ceiling for this pipeline.")
        if ask_yes("Do you have YouTube Premium?", default=False):
            browser = ask_choice("Which browser are you logged into?",
                                 list(VALID_BROWSERS), "safari")
            cfg["cookies_browser"] = browser
            save_config(cfg)

    if not browser:
        report("info", "cookies off", "~128 kbps — `djdl config cookies safari` to change")
        return []

    report("ok", f"cookies from {browser}")

    if not find_exe("deno"):
        report("warn", "deno missing", "YouTube's JS challenge won't solve without it")
        note("Fix: brew install deno   (or re-run `djdl setup` and say yes at step 1)")


    if not IS_MACOS:
        return []

    if browser == "safari":
        state, path = safari_cookie_access()
        if state == "ok":
            report("ok", "Safari cookie store is readable", "Full Disk Access looks granted")
        elif state == "missing":
            report("warn", "no Safari cookie file found", "log into YouTube in Safari first")
        else:
            app = terminal_app_name()
            report("bad", "cannot read Safari's cookies", f"{app} needs Full Disk Access")
            note(f"System Settings → Privacy & Security → Full Disk Access → add {app},\n"
                 f"then fully quit and reopen {app} and run `djdl setup` again.")
            if fix and ask_yes("Open that settings pane now?", default=True):
                open_full_disk_access_pane()
            return ["Full Disk Access is off, so Premium cookies can't be read"]
    else:
        data_dir = BROWSER_DATA_DIRS.get(browser)
        if data_dir and data_dir.exists():
            report("ok", f"{browser} profile found", str(data_dir))
        else:
            report("warn", f"no {browser} profile found", "is it installed and logged in?")
    return []


def step_xml(cfg, fix):
    heading("5. rekordbox.xml")
    xml_path = Path(cfg["xml_path"])
    if xml_path.exists():
        report("ok", "xml exists", str(xml_path))
    else:
        report("bad", "xml not created yet", str(xml_path))
        # rekordbox's file picker can't select a file that doesn't exist, so make
        # one now even if the folder is still empty.
        if not fix:
            return ["rekordbox.xml doesn't exist yet — run `djdl setup`"]
        if ask_yes("Create it now (empty is fine)?", default=True):
            try:
                generate_xml(cfg)
            except OSError as e:
                report("bad", "could not write the xml", str(e))
                return [f"could not write {xml_path}: {e}"]
        else:
            return ["rekordbox.xml doesn't exist yet — rekordbox can't be pointed at it"]
    return []


# ---- rekordbox preferences ------------------------------------------------ #
def rekordbox_settings_files():
    return sorted(Path.home().glob(REKORDBOX_SETTINGS_GLOB),
                  key=lambda p: p.stat().st_mtime, reverse=True)


def read_rekordbox_setting(text, key):
    m = re.search(rf'<VALUE\s+name="{re.escape(key)}"\s+val="([^"]*)"\s*/>', text)
    # Values are XML-escaped in the file; compare against real paths, not entities.
    return xml_unescape_attr(m.group(1)) if m else None


def write_rekordbox_settings(path, updates):
    """Set VALUE entries in rekordbox3.settings, backing the file up first."""
    text = path.read_text(encoding="utf-8")
    backup = path.with_suffix(path.suffix + ".djdl-backup")
    if not backup.exists():
        backup.write_text(text, encoding="utf-8")
    for key, value in updates.items():
        escaped = xml_escape_attr(value)
        pattern = rf'(<VALUE\s+name="{re.escape(key)}"\s+val=")[^"]*("\s*/>)'
        if re.search(pattern, text):
            text = re.sub(pattern, lambda m: m.group(1) + escaped + m.group(2), text)
        else:
            text = text.replace(
                "</PROPERTIES>",
                f'  <VALUE name="{key}" val="{escaped}"/>\n</PROPERTIES>',
            )
    path.write_text(text, encoding="utf-8")
    return backup


def rekordbox_running():
    return run_quiet(["pgrep", "-x", "rekordbox"])[0] == 0


def quit_rekordbox():
    subprocess.run(["osascript", "-e", 'quit app "rekordbox"'],
                   capture_output=True, text=True)
    for _ in range(30):
        if not rekordbox_running():
            return True
        time.sleep(1)
    return False


def step_rekordbox(cfg, fix):
    heading("6. The rekordbox link")
    xml_path = str(Path(cfg["xml_path"]).resolve()) if Path(cfg["xml_path"]).exists() \
        else cfg["xml_path"]

    if not IS_MACOS:
        report("info", "not macOS", "set the preference by hand")
        note(SETUP_HELP.format(xml_path=xml_path,
                               playlist_name=cfg.get("playlist_name", DEFAULT_PLAYLIST_NAME)))
        return []

    settings_files = rekordbox_settings_files()
    if not settings_files:
        report("warn", "no rekordbox settings found", "install rekordbox and launch it once")
        note("Then run `djdl setup` again and it can wire the xml up for you.")
        return []

    settings = settings_files[0]
    text = settings.read_text(encoding="utf-8", errors="replace")
    linked = read_rekordbox_setting(text, "bridgeImportedLibraryFile") or ""
    sidebar = read_rekordbox_setting(text, "showRbXml") or "0"

    linked_ok = linked and os.path.realpath(linked) == os.path.realpath(xml_path)
    if linked_ok:
        report("ok", "rekordbox points at your xml", linked)
    elif linked:
        report("bad", "rekordbox points somewhere else", linked)
    else:
        report("bad", "rekordbox has no xml library set")

    if sidebar == "1":
        report("ok", "the rekordbox xml node is shown in the sidebar")
    else:
        report("bad", "the rekordbox xml node is hidden in the sidebar")

    if linked_ok and sidebar == "1":
        return []

    updates = {}
    if not linked_ok:
        updates["bridgeImportedLibraryFile"] = xml_path
    if sidebar != "1":
        updates["showRbXml"] = "1"

    if not fix:
        note("Run `djdl setup` to have these written for you, or set them by hand:")
        note(SETUP_HELP.format(xml_path=xml_path,
                               playlist_name=cfg.get("playlist_name", DEFAULT_PLAYLIST_NAME)))
        return ["rekordbox is not pointed at your rekordbox.xml yet"]

    print()
    note(f"djdl can write these into {settings.name} for you:")
    for key, value in updates.items():
        note(f"  {key} = {value}")
    if not ask_yes("Write them?", default=True):
        note("Skipped. The manual steps are in `djdl setup-help`.")
        return ["rekordbox is not pointed at your rekordbox.xml yet"]

    # rekordbox rewrites this file when it quits, so it has to be closed first
    # or our edit gets clobbered.
    if rekordbox_running():
        report("warn", "rekordbox is running", "it overwrites its settings on quit")
        if not ask_yes("Quit rekordbox now?", default=True):
            note("Quit rekordbox and re-run `djdl setup`.")
            return ["rekordbox was running, so its settings were left alone"]
        if not quit_rekordbox():
            report("bad", "rekordbox didn't quit", "quit it by hand, then re-run `djdl setup`")
            return ["rekordbox was still running, so its settings were left alone"]
        report("ok", "rekordbox quit")

    try:
        backup = write_rekordbox_settings(settings, updates)
    except OSError as e:
        report("bad", "could not write rekordbox settings", str(e))
        return [f"could not write {settings}: {e}"]
    report("ok", "rekordbox settings written", f"backup at {backup.name}")
    note("Start rekordbox — 'rekordbox xml' will be in the left sidebar.")
    return []


def step_probe(cfg, fix):
    """Read-only end-to-end check: ask YouTube what it would hand us."""
    if not fix:
        return []
    heading("7. Live check")
    if not ask_yes("Ask YouTube what quality it would serve? (no download)", default=True):
        return []

    exe = find_exe("yt-dlp")
    cmd = [exe, "--ignore-config", "--simulate", "--no-warnings", "--no-playlist",
           "-f", "141/bestaudio[ext=m4a]/bestaudio",
           "--print", "%(format_id)s|%(abr)s|%(acodec)s", PROBE_URL]
    browser = cfg.get("cookies_browser", "")
    if browser:
        cmd += ["--cookies-from-browser", browser]

    print(paint("    probing…", "90"))
    rc, out = run_quiet(cmd, timeout=120)
    line = next((l for l in out.strip().splitlines() if "|" in l), "")
    if rc != 0 or not line:
        report("bad", "the probe failed")
        if "Operation not permitted" in out:
            note(f"Full Disk Access is off for {terminal_app_name()} — see step 4.")
        elif "Only images are available" in out:
            note("That's the missing-deno symptom: brew install deno")
        else:
            note((out.strip().splitlines() or ["no output"])[-1][:300])
        return ["the live quality check failed"]

    fmt, abr, codec = (line.split("|") + ["", ""])[:3]
    try:
        kbps = float(abr)
    except ValueError:
        kbps = 0.0
    detail = f"format {fmt}, {codec}, ~{kbps:.0f} kbps"
    if browser and (fmt == "141" or kbps >= 200):
        report("ok", "Premium quality confirmed", detail)
    elif browser:
        report("warn", "cookies are on but YouTube served the free stream", detail)
        note("This probe track does have a 256k stream, so something is capping you:\n"
             "  · yt-dlp is stale — upgrade it (step 1 offers to), or\n"
             "  · not logged into YouTube Premium in that browser, or\n"
             "  · deno missing (brew install deno), or\n"
             "  · YouTube broke the player client yt-dlp needs — this happens every\n"
             "    few weeks and is fixed by a later yt-dlp release, not by you.\n"
             "Downloads still work, just at ~128 kbps.")
    else:
        report("ok", "free-tier quality confirmed", detail)
        note("Have Premium? `djdl config cookies safari` roughly doubles the bitrate.")
    return []


def cmd_setup(fix=True):
    title = "djdl setup" if fix else "djdl doctor"
    print(paint(f"\n{title} — checking everything end to end", "1"))
    if fix and not interactive():
        print(paint("  (not a terminal — running in read-only check mode)", "90"))
        fix = False

    blockers = []
    blockers += step_dependencies(fix)
    blockers += step_command(fix)
    cfg, config_blockers = step_config(fix)
    blockers += config_blockers
    if config_blockers:
        # Everything below needs a usable music folder.
        return finish(blockers, None)
    blockers += step_cookies(cfg, fix)
    blockers += step_xml(cfg, fix)
    blockers += step_rekordbox(cfg, fix)
    blockers += step_probe(cfg, fix)
    return finish(blockers, cfg)


def finish(blockers, cfg):
    heading("Summary")
    if not blockers:
        report("ok", "everything checks out")
        if cfg:
            note(f"Paste a link to get going:  djdl https://youtube.com/watch?v=…\n"
                 f"Tracks land in {cfg['music_dir']}\n"
                 f"After each download, hit refresh on the 'rekordbox xml' node in\n"
                 f"rekordbox, open the '{cfg.get('playlist_name', DEFAULT_PLAYLIST_NAME)}' "
                 f"playlist, select all → Import to Collection.")
        return 0
    for item in blockers:
        report("bad", item)
    note("Fix those and run `djdl setup` again.")
    return 1


